[locale]

translations=PackedStringArray( "res://Translations/fr.po", "res://Translations/de.po", "res://Translations/nl.po", "res://Translations/ru.po", "res://Translations/pt.po", "res://Translations/eo.po", "res://Translations/it.po", "res://Translations/es.po", "res://Translations/nb_NO.po", "res://Translations/id.po", "res://Translations/pl.po", "res://Translations/zh_Hans.po", "res://Translations/pt_BR.po", "res://Translations/bg.po", "res://Translations/hu.po", "res://Translations/ko.po", "res://Translations/ta.po" )

[network]

tls/certificate_bundle_override="res://master_server.crt"

[physics]

3d/default_gravity=98.1
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

vram_compression/import_etc=true
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_environment="res://default_env.tres"
